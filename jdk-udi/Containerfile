###### START image 'ubi10/openjdk-21:1.24'
###### \
        # Set 'ubi10/openjdk-21' image defined environment variables
        ENV \
            JBOSS_IMAGE_NAME="ubi10/openjdk-21" \
            JBOSS_IMAGE_VERSION="1.24" \
            LANG="C.utf8" \
            PATH="$PATH:"/usr/libexec/s2i""
        # Set 'ubi10/openjdk-21' image defined labels
        LABEL \
            com.redhat.component="openjdk-21-ubi10-container" \
            com.redhat.license_terms="https://www.redhat.com/en/about/red-hat-end-user-license-agreements#UBI" \
            description="Source To Image (S2I) image for Red Hat OpenShift providing OpenJDK 21" \
            io.cekit.version="4.17.0.dev0" \
            io.k8s.description="Platform for building and running plain Java applications (fat-jar and flat classpath)" \
            io.k8s.display-name="Java Applications" \
            io.openshift.tags="builder,java" \
            maintainer="Red Hat OpenJDK <openjdk@redhat.com>" \
            name="ubi10/openjdk-21" \
            org.opencontainers.image.documentation="https://rh-openjdk.github.io/redhat-openjdk-containers/" \
            org.opencontainers.image.revision="ubi10" \
            org.opencontainers.image.source="https://github.com/rh-openjdk/redhat-openjdk-containers" \
            org.opencontainers.image.source="https://github.com/rh-openjdk/redhat-openjdk-containers" \
            summary="Source To Image (S2I) image for Red Hat OpenShift providing OpenJDK 21" \
            usage="https://rh-openjdk.github.io/redhat-openjdk-containers/" \
            version="1.24"
        # Exposed ports in 'ubi10/openjdk-21' image
        EXPOSE 8080 8443
###### /
###### END image 'ubi10/openjdk-21:1.24'



    # Switch to 'root' user and remove artifacts and modules
    USER root
    RUN rm -rf "/tmp/scripts" "/tmp/artifacts"
    # Clear package manager metadata
    RUN microdnf clean all \
    && rm -rf "/var/cache/yum" "/var/lib/dnf" "/var/cache/apt" "/var/cache/dnf"
    # Define the user
    USER 185
    # Define the working directory
    WORKDIR /home/default
    # Define run cmd
    CMD ["/usr/libexec/s2i/run"]
## /
## END target image
