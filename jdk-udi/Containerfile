
This is a Dockerfile for the ubi10/openjdk-21:1.24 image.


## START target image ubi10/openjdk-21:1.24
## \
    FROM registry.redhat.io/ubi10/ubi@sha256:864f6b94f9f64a059aed7dc8f95b0854f5eb06140f95aed32300da63a1f7877d
    #FROM registry.access.redhat.com/ubi10/ubi-minimal@sha256:04140c8d78c6c6915b5c1fdad2f16d10eac3630c3339999ccdf659d8c903be50


    USER root

###### START module 'jboss.container.user:2.0'
###### \
        # Copy 'jboss.container.user' module content
        COPY modules/jboss.container.user /tmp/scripts/jboss.container.user
        # Switch to 'root' user for package management for 'jboss.container.user' module defined packages
        USER root
        RUN : \
        # Install packages defined in the 'jboss.container.user' module
        && microdnf --setopt=install_weak_deps=0 --setopt=tsflags=nodocs install -y shadow-utils \
            && rpm -q shadow-utils \
        && :

        # Set 'jboss.container.user' module defined environment variables
        ENV \
            GECOS="Default user" \
            HOME="/home/default" \
            UID="185" \
            USER="default"
        # Custom scripts from 'jboss.container.user' module
        USER root
        RUN sh -x "/tmp/scripts/jboss.container.user/configure.sh"
###### /
###### END module 'jboss.container.user:2.0'

###### START module 'jboss.container.openjdk:0'
###### \
###### /
###### END module 'jboss.container.openjdk:0'

###### START module 'jboss.container.openjdk.jre:21'
###### \
        # Switch to 'root' user for package management for 'jboss.container.openjdk.jre' module defined packages
        USER root
        RUN : \
        # Install packages defined in the 'jboss.container.openjdk.jre' module
        && microdnf --setopt=install_weak_deps=0 --setopt=tsflags=nodocs install -y java-21-openjdk-headless \
            && rpm -q java-21-openjdk-headless \
        && :

        # Set 'jboss.container.openjdk.jre' module defined environment variables
        ENV \
            JAVA_HOME="/usr/lib/jvm/java-21-openjdk" \
            JAVA_VENDOR="openjdk" \
            JAVA_VERSION="21" \
            JBOSS_CONTAINER_OPENJDK_JRE_MODULE="/opt/jboss/container/openjdk/jre"
        # Set 'jboss.container.openjdk.jre' module defined labels
        LABEL \
            org.jboss.product="openjdk" \
            org.jboss.product.openjdk.version="21" \
            org.jboss.product.version="21"
###### /
###### END module 'jboss.container.openjdk.jre:21'

